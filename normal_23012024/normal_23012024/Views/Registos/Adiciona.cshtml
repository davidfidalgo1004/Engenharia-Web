@model normal_23012024.Models.RegistoUtilizador


@{
    ViewData["Title"] = "Create";
}

<h1>Adiciona</h1>

<h4>RegistoUtilizador</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Adiciona">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Nome" class="control-label"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Regime" class="control-label"></label>
                <select asp-for="Regime" class="form-control" >
                    <option value="Ordinario">Ordinário</option>
                    <option value="Super">Super</option>
                    <option value="Especial">Especial</option>
                </select>
                <span asp-validation-for="Regime" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <input type="submit" value="Adiciona" class="btn btn-outline-primary" />
                <a asp-action="Lista" class="btn btn-outline-danger">Cancela</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
